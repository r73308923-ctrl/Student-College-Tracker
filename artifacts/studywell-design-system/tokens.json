  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": { "$value": ["DM Sans", "sans-serif"], "$description": "Friendly, compact UI and body text." },
      "serif": { "$value": ["Fraunces", "serif"], "$description": "Editorial display face for headings and high-emphasis copy." },
      "mono": { "$value": ["IBM Plex Mono", "monospace"], "$description": "Data values, dates, and compact metrics." }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": { "$value": "0.85rem", "$description": "Soft rounded base; pills use full rounding and cards use the large step." }
  },
  "spacing": {
    "$type": "dimension",
    "base": { "$value": "0.25rem", "$description": "Four-pixel rhythm used for compact controls, cards, and page composition." }
  }
